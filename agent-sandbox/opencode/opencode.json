{
    "$schema": "https://opencode.ai/config.json",
    "model": "llamacpp/qwen3.8-27b",
    "share": "disabled",
    "permission": {
        "external_directory": {
            "/tmp": "allow",
            "/tmp/**": "allow"
        }
    },
    "provider": {
        "llamacpp": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "llama.cpp (host)",
            "options": {
                "baseURL": "http://llm.internal:8080/v1",
                "apiKey": "{file:/run/secrets/llm-api-key}"
            },
            "models": {
                "qwen3.8-27b": {
                    "name": "Qwen 3.8 27B"
                }
            }
        }
    }
}
