<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Runs `llama-server` in router mode with the presets in
    `~/.config/llama.cpp/models.ini`, keeping at most one model in memory and
    unloading it after five minutes without requests. Requests need the API key
    in `~/.local/share/llama.cpp/api-key`, and only web pages served from
    localhost may make cross-origin requests. Installed by
    `install/macos-launchd-services.sh`, which also creates the API key and
    replaces `@HOME@` with the home directory, as launchd can't expand
    variables.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.llama-cpp.server</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/llama-server</string>
        <string>--models-preset</string>
        <string>@HOME@/.config/llama.cpp/models.ini</string>
        <string>--models-max</string>
        <string>1</string>
        <string>--sleep-idle-seconds</string>
        <string>300</string>
        <string>--api-key-file</string>
        <string>@HOME@/.local/share/llama.cpp/api-key</string>
        <string>--cors-origins</string>
        <string>localhost</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8080</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>@HOME@/Library/Logs/llama-server.log</string>
    <key>StandardErrorPath</key>
    <string>@HOME@/Library/Logs/llama-server.log</string>
</dict>
</plist>
