# Load more recent module versions, in a single call as each `module` call is
# slow (modules are loaded in the order given)
module load \
    git \
    tmux \
    pixi \
    nextflow \
    PDC \
    apptainer

# Add custom software to PATH
export PATH="$HOME/opt/nvim/bin:$PATH"
export PATH="$HOME/opt/ripgrep:$PATH"

# Set Nextflow-related environment variables
export NXF_HOME=~/nbis-testing/erikfas/.nextflow
export NXF_APPTAINER_CACHEDIR=~/nbis-testing/erikfas/.apptainer
export NXF_SINGULARITY_CACHEDIR=~/nbis-testing/erikfas/.singularity

# Alias to check personal storage
alias storage='lfs quota -hp $UID /cfs/klemming'
