# Do nothing for non-interactive shells
[[ $- != *i* ]] && return

# Source custom HPC profile if in a SSH session on a known HPC system
if [ -n "$SSH_CLIENT" ] || [ -n "$SSH_TTY" ]; then
    if [[ "$HOSTNAME" == *uppmax* ]]; then
        source "$HOME/.dotfiles/bash/uppmax_profile"
    elif [[ -d /cfs/klemming ]]; then
        source "$HOME/.dotfiles/bash/pdc_profile"
    fi
fi

OS="$(uname)"

# Linux-specific settings
if [[ "$OS" == "Linux" ]]; then
    # Specify location of diff-highlight (included in Git core)
    export PATH="$PATH:/usr/share/git-core/contrib"

    # Specify location of manual Neovim 0.12 installation
    export PATH="/opt/nvim-linux-x86_64/bin:$PATH"

    # Icon locations
    export XDG_ICON_DIRS="/usr/share/icons:/usr/local/share/icons:$HOME/.local/share/icons"

    # Use GNOME as default XDG desktop; gtk as fallback
    export XDG_CURRENT_DESKTOP=GNOME
    export QT_QPA_PLATFORMTHEME=gtk

    # Point `niri msg` to the currently running Niri instance (if any)
    source "$HOME/.dotfiles/scripts/niri-set-socket-env.sh"
fi

# MacOS-specific settings
if [[ "$OS" == "Darwin" ]]; then

    # Silence the OS X zsh message
    export BASH_SILENCE_DEPRECATION_WARNING=1

    # Add Homebrew's envs; same as `eval $(brew shellenv)`, but without the slow
    # `brew` call
    export HOMEBREW_PREFIX="/opt/homebrew"
    export HOMEBREW_CELLAR="/opt/homebrew/Cellar"
    export HOMEBREW_REPOSITORY="/opt/homebrew"
    export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
    export MANPATH="/opt/homebrew/share/man${MANPATH+:$MANPATH}:"
    export INFOPATH="/opt/homebrew/share/info:${INFOPATH:-}"

    # Local paths
    PATH="/usr/local/bin:$PATH"

    # Set PATH for Python 3.12 (last in PATH, as a fallback)
    export PATH="$PATH:/Library/Frameworks/Python.framework/Versions/3.12/bin"

    # Add Homebrew paths to PATH
    export PATH="/opt/homebrew/opt/gnu-tar/libexec/gnubin:$PATH"
    export PATH="/opt/homebrew/opt/git/share/git-core/contrib/diff-highlight/:$PATH"

    # Explicitly add path for Java installation (fixes issues with Java/Nextflow)
    export JAVA_HOME="/opt/homebrew/opt/openjdk@21"

    # Bash completion (also loads completions installed by Homebrew packages)
    [[ -r "/opt/homebrew/etc/profile.d/bash_completion.sh" ]] \
        && . "/opt/homebrew/etc/profile.d/bash_completion.sh"

    # Files to ignore for tab-completion
    export FIGNORE="$FIGNORE:.un~:DS_Store"

    # Source Conda
    source "$HOME/opt/miniforge3/etc/profile.d/conda.sh"

    # Claude Code sandbox aliases
    alias claude-sandbox='~/projects/claude-sandbox/run-claude-egress-filtered.sh'
    alias claude='~/projects/claude-sandbox/run-claude-egress-open.sh'

    # Use GNU readlink
    alias readlink='greadlink'

fi

# Add to PATH
export PATH="$HOME/opt:$PATH" # TODO: Remove from MacOS and use `.local/bin`
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.pixi/bin:$PATH"

# Autocompletion for Pixi
eval "$(pixi completion --shell bash)"

# Enable fzf
eval "$(fzf --bash)"

# Set colours (fzf, bat, etc.) for the current host's colour scheme
DOTFILES_COLOURSCHEME="$("$HOME/.dotfiles/scripts/dotfiles-colourscheme.sh")"
export DOTFILES_COLOURSCHEME
source "$HOME/.dotfiles/bash/colours-$DOTFILES_COLOURSCHEME.sh"

# Set up Luarocks paths for Busted-based testing of Neovim plugins; run
# `lua-test-env` once in the shell used for testing (not done at start-up, as
# it's slow). Requires luarocks `luarocks --lua-version 5.1 install busted` as
# well as `luarocks --lua-version 5.1 install nlua`.
lua-test-env() { eval "$(luarocks path --lua-version 5.1)"; }

# Locale
export LC_ALL=en_GB.UTF-8
export LANG=en_GB.UTF-8

# Default editor
export EDITOR=nvim

# Manpager
export MANPAGER='nvim +Man!'

# List command ----------------------------------------------------------------

# List colours
LS_COLORS='ow=01;90' # Other-writable directory (bold black)
LS_COLORS=$LS_COLORS':di=00;34' # Directories (blue)
LS_COLORS=$LS_COLORS':ln=00;36' # Symbolic links (teal)
LS_COLORS=$LS_COLORS':ex=00;33' # Executable (orange)
LS_COLORS=$LS_COLORS':mi=01;31' # Missing symlink (bold red)
export LS_COLORS

# Use either `ls`  or `gls` (GNU-ls), as appropriate
if hash gls 2>/dev/null; then

    # GNU `gls` that ignore OSX specific home directories
    LL='gls --literal'
    LL=$LL' --hide=Desktop'
    LL=$LL' --hide=Documents'
    LL=$LL' --hide=Downloads'
    LL=$LL' --hide=Library'
    LL=$LL' --hide=Movies'
    LL=$LL' --hide=Music'
    LL=$LL' --hide=Pictures'
    LL=$LL' --hide=Public'
else

    # Standard `ls`
    LL='ls'
fi

# Final long-format, coloured and human-readable `ll` command
alias ll=$LL' -lvh --color=auto --group-directories-first'

# Aliases --------------------------------------------------------------------

