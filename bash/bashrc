# Prompt ---------------------------------------------------------------------

# Function to get conda env if in an activated environment
# (uses only Bash built-ins, as this runs at every prompt)
conda_env() {
    if [[ -n "$CONDA_DEFAULT_ENV" ]]; then
        printf '(%s) ' "${CONDA_DEFAULT_ENV##*/}"
    fi
}

# Function to get branch if inside a git repository
# This is more efficient than doing `git branch` and parsing the output on
# systems like Dardel (using Lustre), where `git` commands can be slow.
git_branch() {

    # Start in current directory without knowing where the Git directory is
    local DIR="$PWD"
    local GIT_DIR=""
    local HEAD=""

    # Loop until the Git directory is found
    while [[ -n "$DIR" ]]; do

        # If Git directory is found, break loop
        if [[ -d "$DIR/.git" ]]; then
            GIT_DIR="$DIR/.git"
            break
        fi

        # In worktrees and submodules `.git` is a file containing `gitdir:
        # <path>`, pointing to the actual Git directory
        if [[ -f "$DIR/.git" ]]; then
            read -r GIT_DIR < "$DIR/.git"
            GIT_DIR="${GIT_DIR#gitdir: }"
            [[ "$GIT_DIR" != /* ]] && GIT_DIR="$DIR/$GIT_DIR"
            break
        fi

        # Stop if we've reached the system root
        [[ "$DIR" == "/" ]] && break

        # Move up one level in the directory hierarchy
        DIR="${DIR%/*}"
    done

    # Only proceed if we find both the Git directory and HEAD
    if [[ -n "$GIT_DIR" && -f "$GIT_DIR/HEAD" ]]; then
        # Read in HEAD, which either contains e.g. `ref: refs/heads/<branch>` on
        # a branch, or the full SHA when HEAD is detached
        read -r HEAD < "$GIT_DIR/HEAD"
        case "$HEAD" in
            ref:\ refs/heads/*)
                # Remove `ref: refs/heads/` when on a branch
                printf ' (%s)' "${HEAD#ref: refs/heads/}"
                ;;
            *)
                # Truncate to the standard 7 characters for full SHAs
                printf ' (HEAD detached at %.7s)' "$HEAD"
                ;;
        esac
    fi
}

# Build prompt
export PS1='\[\e[0;95m\]$(conda_env)'       # Conda environment (purple)
export PS1=$PS1'\[\e[m\][\h: '              # Hostname (grey)
export PS1=$PS1'\[\e[0;34m\]\w\[\e[m\]]'    # Current directory (blue)
export PS1=$PS1'\[\e[0;36m\]$(git_branch)' # Git branch (teal)
export PS1=$PS1'\[\e[m\] \$ '               # End (grey)
