#!/usr/bin/env bash
set -euo pipefail

# Git hook dispatcher script for mixing global hooks with local, per-repo hooks.
# Will run global hooks for every repo on the system, an additionally check for
# local hooks and run those as well. Global hooks are executed before local
# ones.

HOOK_NAME=$(basename "$0")

# -----------------------------------------
# Global hooks
# -----------------------------------------

case "$HOOK_NAME" in
    pre-commit)
        if command -v gitleaks >/dev/null 2>&1; then
            # Only print output when leaks are found
            gitleaks git --pre-commit --staged --redact --verbose \
                --no-banner --log-level warn || exit 1
        fi
        ;;
esac

# -----------------------------------------
# Local hooks
# -----------------------------------------

GIT_DIR=$(git rev-parse --git-common-dir 2>/dev/null) || exit 0
GIT_DIR=$(cd "$GIT_DIR" && pwd)
LOCAL_HOOK="$GIT_DIR/hooks/$HOOK_NAME"

if [ -x "$LOCAL_HOOK" ]; then
    "$LOCAL_HOOK" "$@" || exit $?
fi

# Finish with exit status zero if no local hooks found
exit 0
