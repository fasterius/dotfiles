snippet hook-lint "Git pre-commit hook for general linting"
	#!/bin/bash

	# Prevent commit on failed EditorConfig, Ruff or Prettier

	exit_function() {
	    echo "The \`\$1\` linting failed; will not commit."
	    exit 1
	}

	editorconfig-checker || exit_function "editorconfig"
	npx prettier --check . || exit_function "prettier"
	ruff . || exit_function "ruff"

snippet hook-nfcore-lint "Git pre-push hook for nf-core linting"
	#!/bin/bash

	# Prevent push on failed nf-core linting

	linting_function() {

	    # Makes Git run in an interative environment, required for input
	    exec </dev/tty

	    # Get user choice
	    echo "Linting failed, do you still wish to push?"
	    select CHOICE in "Yes" "No"; do
	        case \${CHOICE} in
	            Yes ) echo "Ignored failed linting and pushing" ; break ;;
	            No ) echo "The linting failed; will not push" ; exit 1 ;;
	        esac
	    done

	}

	nf-core pipelines lint || linting_function

snippet hook-conventional-commits "Git commit-msg hook for conventional commits"
    #!/bin/bash

    # Check for Conventional Commits standard adherence, with deviation from the
    # default configuration (allowing WIP commits and subject line length), plus
    # stripping of e.g. informational comment lines prior to checking for cleaner
    # and more overviewable output.

    # Create a temporary file to store stripped commit message in and delete it
    # after script completion
    STRIPPED=$(mktemp)
    trap 'rm -f "$STRIPPED"' EXIT

    # Strip commit message using Git itself
    git stripspace --strip-comments < "$1" > "$STRIPPED"

    # Validate the stripped commit message
    commit-check \
        --message "$STRIPPED" \
        --allow-wip-commits true \
        --subject-max-length 72
